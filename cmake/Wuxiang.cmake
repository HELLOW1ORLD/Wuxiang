include_guard(GLOBAL)

# Compiles a module independently; the consuming executable keeps its MSVC
# compiler. Explicit target-local flags prevent accidental LTO or CRT drift.
function(wuxiang_add_protected_library NAME)
  cmake_parse_arguments(WX "" "SEED;FUNCTIONS;MODE;CXX_STANDARD" "SOURCES;COMPILE_OPTIONS;INCLUDE_DIRECTORIES" ${ARGN})
  if(NOT WIN32 OR NOT MSVC)
    message(FATAL_ERROR "Wuxiang mixed-library adapter requires a Windows MSVC host toolchain")
  endif()
  foreach(TOOL WUXIANG_CLANG_CL WUXIANG_LLC WUXIANG_IR)
    if(NOT EXISTS "${${TOOL}}")
      message(FATAL_ERROR "Set ${TOOL} to a project-local executable")
    endif()
  endforeach()
  if(NOT WX_SOURCES)
    message(FATAL_ERROR "wuxiang_add_protected_library requires SOURCES")
  endif()
  if("${WX_SEED}" STREQUAL "")
    set(WX_SEED 1)
  endif()
  if(NOT WX_MODE)
    set(WX_MODE balanced)
  endif()
  if(NOT WX_CXX_STANDARD)
    set(WX_CXX_STANDARD 20)
  endif()
  if(NOT WX_CXX_STANDARD MATCHES "^(17|20)$")
    message(FATAL_ERROR "Wuxiang v1 validates only C++17 and C++20")
  endif()
  foreach(FLAG IN LISTS WX_COMPILE_OPTIONS)
    string(TOLOWER "${FLAG}" WX_LOWER_FLAG)
    if(NOT WX_LOWER_FLAG MATCHES "^(/fp:(strict|precise|fast)|/arch:(avx|avx2|sse2)|/zc:(__cplusplus|preprocessor)|/permissive-|/utf-8|/wx|/w[0-4]|/wd[0-9]+)$")
      message(FATAL_ERROR "Unsupported protected module flag; output/ABI overrides forbidden: ${FLAG}")
    endif()
  endforeach()
  find_path(WUXIANG_INCLUDE_DIR wuxiang/protect.h
    PATHS "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/../include" "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/../../../include"
    NO_DEFAULT_PATH)
  if(NOT WUXIANG_INCLUDE_DIR)
    message(FATAL_ERROR "Set WUXIANG_INCLUDE_DIR to the directory containing wuxiang/protect.h")
  endif()
  set(INCLUDES "/I${WUXIANG_INCLUDE_DIR}")
  foreach(DIR IN LISTS WX_INCLUDE_DIRECTORIES)
    get_filename_component(DIR "${DIR}" ABSOLUTE BASE_DIR "${CMAKE_CURRENT_SOURCE_DIR}")
    list(APPEND INCLUDES "/I${DIR}")
  endforeach()
  set(OBJECTS)
  set(INDEX 0)
  foreach(SOURCE IN LISTS WX_SOURCES)
    math(EXPR INDEX "${INDEX} + 1")
    get_filename_component(SOURCE "${SOURCE}" ABSOLUTE BASE_DIR "${CMAKE_CURRENT_SOURCE_DIR}")
    if(SOURCE MATCHES "\\.(ixx|cppm)$")
      message(FATAL_ERROR "C++ Modules are outside the v1 support contract")
    endif()
    set(BASE "${CMAKE_CURRENT_BINARY_DIR}/wuxiang/${NAME}/${INDEX}")
    set(SELECT)
    if(WX_FUNCTIONS)
      list(APPEND SELECT --functions "${WX_FUNCTIONS}")
    endif()
    add_custom_command(OUTPUT "${BASE}.obj" "${BASE}.coverage.json"
      COMMAND "${CMAKE_COMMAND}" -E make_directory "${CMAKE_CURRENT_BINARY_DIR}/wuxiang/${NAME}"
      COMMAND "${WUXIANG_CLANG_CL}" /nologo /O2 /MD /EHsc /GR "/std:c++${WX_CXX_STANDARD}" /c /clang:-emit-llvm /clang:-o "/clang:${BASE}.bc" /clang:-MMD /clang:-MF "/clang:${BASE}.d" ${INCLUDES} ${WX_COMPILE_OPTIONS} "${SOURCE}"
      COMMAND "${WUXIANG_IR}" "${BASE}.bc" -o "${BASE}.protected.bc" --report "${BASE}.coverage.json" --seed "${WX_SEED}" --mode "${WX_MODE}" ${SELECT}
      COMMAND "${WUXIANG_LLC}" -O=2 -filetype=obj -mtriple=x86_64-pc-windows-msvc "${BASE}.protected.bc" -o "${BASE}.obj"
      DEPENDS "${SOURCE}" "${WUXIANG_IR}" "${WUXIANG_INCLUDE_DIR}/wuxiang/protect.h"
      DEPFILE "${BASE}.d"
      VERBATIM COMMAND_EXPAND_LISTS)
    set_source_files_properties("${BASE}.obj" PROPERTIES GENERATED TRUE EXTERNAL_OBJECT TRUE)
    list(APPEND OBJECTS "${BASE}.obj")
  endforeach()
  add_library(${NAME} STATIC ${OBJECTS})
  target_include_directories(${NAME} PUBLIC "${WUXIANG_INCLUDE_DIR}" ${WX_INCLUDE_DIRECTORIES})
  target_compile_definitions(${NAME} INTERFACE _ITERATOR_DEBUG_LEVEL=0)
  set_target_properties(${NAME} PROPERTIES LINKER_LANGUAGE CXX MSVC_RUNTIME_LIBRARY MultiThreadedDLL WUXIANG_PROTECTED_LIBRARY TRUE)
endfunction()

# Use this helper for every consuming executable/library. The protected module
# uses /MD and release STL layouts even when the host has debug information.
function(wuxiang_link_protected_library CONSUMER LIBRARY)
  if(NOT TARGET ${CONSUMER} OR NOT TARGET ${LIBRARY})
    message(FATAL_ERROR "wuxiang_link_protected_library requires existing consumer and library targets")
  endif()
  get_target_property(PROTECTED ${LIBRARY} WUXIANG_PROTECTED_LIBRARY)
  if(NOT PROTECTED)
    message(FATAL_ERROR "${LIBRARY} was not created by wuxiang_add_protected_library")
  endif()
  get_target_property(CRT ${CONSUMER} MSVC_RUNTIME_LIBRARY)
  if(CRT AND NOT CRT STREQUAL "MultiThreadedDLL")
    message(FATAL_ERROR "${CONSUMER} must use MultiThreadedDLL (/MD), received ${CRT}")
  endif()
  foreach(PROPERTY COMPILE_OPTIONS COMPILE_FLAGS COMPILE_DEFINITIONS)
    get_target_property(SETTINGS ${CONSUMER} ${PROPERTY})
    if(SETTINGS MATCHES "(^|[ ;])(/MDd|/MTd?)([ ;]|$)" OR SETTINGS MATCHES "_ITERATOR_DEBUG_LEVEL=[1-9]")
      message(FATAL_ERROR "${CONSUMER} has ABI-incompatible ${PROPERTY}; use MultiThreadedDLL and _ITERATOR_DEBUG_LEVEL=0")
    endif()
  endforeach()
  set_target_properties(${CONSUMER} PROPERTIES MSVC_RUNTIME_LIBRARY MultiThreadedDLL)
  target_compile_definitions(${CONSUMER} PRIVATE _ITERATOR_DEBUG_LEVEL=0)
  target_link_libraries(${CONSUMER} PRIVATE ${LIBRARY})
endfunction()
